                    <button id="modal-confirm-btn" class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition">Nộp bài ngay</button>
                `;
                document.getElementById('modal-confirm-btn').onclick = () => {
                    closeModal();
                    if (onConfirm) onConfirm();
                };
            }

            const modal = document.getElementById('custom-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            const modal = document.getElementById('custom-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function openConfigModal() {
            const savedUrl = localStorage.getItem('toan12_gas_url') || '';
            document.getElementById('gas-url-input').value = savedUrl;
            const modal = document.getElementById('config-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeConfigModal() {
            const modal = document.getElementById('config-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function saveGasUrl() {
            const url = document.getElementById('gas-url-input').value.trim();
            localStorage.setItem('toan12_gas_url', url);
            closeConfigModal();
            showModal("Đã lưu cấu hình", url ? "Đã lưu đường dẫn Google Apps Script. Kết quả sẽ tự động gửi về Google Sheet khi học sinh nộp bài." : "Đã xóa đường dẫn Google Apps Script.", true);
        }

        function copyGasCode() {
            const codeText = document.getElementById('gas-code-block').innerText;
            const textarea = document.createElement('textarea');
            textarea.value = codeText;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);

            const btnText = document.getElementById('copy-btn-text');
            btnText.textContent = "Đã chép!";
            setTimeout(() => { btnText.textContent = "Sao chép mã"; }, 2000);
        }

        // ==========================================
        // 5. CHẤM ĐIỂM & XUẤT KẾT QUẢ GOOGLE SHEET
        // ==========================================
        function confirmSubmit() {
            if (isSubmitted) return;
            const name = document.getElementById('student-name').value.trim();
            const sClass = document.getElementById('student-class').value.trim();

            if (!name || !sClass) {
                showModal("Thiếu thông tin thí sinh", "Vui lòng nhập đầy đủ <b>Họ và tên</b> và <b>Lớp</b> trước khi nộp bài!", true);
                document.getElementById('student-name').focus();
                return;
            }

            showModal(
                "Xác nhận nộp bài",
                `Thí sinh <b>${name}</b> (Lớp <b>${sClass}</b>) có chắc chắn muốn kết thúc bài làm và nộp kết quả không?`,
                false,
                () => submitExam(false)
            );
        }

        function submitExam(isAuto = false) {
            if (isSubmitted) return;
            isSubmitted = true;
            clearInterval(timerInterval);

            const name = document.getElementById('student-name').value.trim() || "Thí sinh ẩn danh";
            const sClass = document.getElementById('student-class').value.trim() || "Không rõ";
            const sId = document.getElementById('student-id').value.trim() || "";

            const elapsedSeconds = (90 * 60) - timeRemaining;
            const durationStr = `${Math.floor(elapsedSeconds / 60)} phút ${elapsedSeconds % 60} giây`;

            const labels = ['A', 'B', 'C', 'D'];
            let scoreP1 = 0;
            let detailP1 = [];

            // 1. Chấm Phần I (0.25đ / câu)
            part1Data.forEach(q => {
                const checked = document.querySelector(`input[name="p1_q${q.id}"]:checked`);
                const userAns = checked ? parseInt(checked.value) : -1;
                const navBtn = document.getElementById(`nav-p1-q${q.id}`);

                // Disable inputs
                document.querySelectorAll(`input[name="p1_q${q.id}"]`).forEach(inp => inp.disabled = true);

                // Highlight correct answer
                const correctLbl = document.getElementById(`lbl_p1_q${q.id}_opt${q.answer}`);
                correctLbl.classList.add('!bg-emerald-50', '!border-emerald-500', '!text-emerald-900', 'font-semibold');

                if (userAns === q.answer) {
                    scoreP1 += 0.25;
                    navBtn.className = "h-8 rounded-lg bg-emerald-500 text-white text-xs font-semibold flex items-center justify-center";
                    detailP1.push(`C${q.id}:${labels[userAns]}(Đ)`);
                } else {
                    if (userAns !== -1) {
                        const wrongLbl = document.getElementById(`lbl_p1_q${q.id}_opt${userAns}`);
                        wrongLbl.classList.add('!bg-rose-50', '!border-rose-500', '!text-rose-900');
                        detailP1.push(`C${q.id}:${labels[userAns]}(S)`);
                    } else {
                        detailP1.push(`C${q.id}:Trống`);
                    }
                    navBtn.className = "h-8 rounded-lg bg-rose-500 text-white text-xs font-semibold flex items-center justify-center";
                }

                document.getElementById(`exp-p1-q${q.id}`).classList.remove('hidden');
            });

            // 2. Chấm Phần II (Thang điểm BGD: 1 ý đúng = 0.1đ, 2 ý = 0.25đ, 3 ý = 0.5đ, 4 ý = 1.0đ)
            let scoreP2 = 0;
            let detailP2 = [];

            part2Data.forEach(q => {
                let correctCount = 0;
                let subLogs = [];

                q.subQuestions.forEach(sub => {
                    const checked = document.querySelector(`input[name="p2_q${q.id}_${sub.key}"]:checked`);
                    document.querySelectorAll(`input[name="p2_q${q.id}_${sub.key}"]`).forEach(inp => inp.disabled = true);
                    const row = document.getElementById(`row-p2-q${q.id}-${sub.key}`);

                    if (checked) {
                        const userBool = (checked.value === "true");
                        if (userBool === sub.answer) {
                            correctCount++;
                            row.classList.add('bg-emerald-50/70');
                            subLogs.push(`${sub.key}:${userBool ? 'Đ' : 'S'}(✓)`);
                        } else {
                            row.classList.add('bg-rose-50/70');
                            subLogs.push(`${sub.key}:${userBool ? 'Đ' : 'S'}(✗)`);
                        }
                    } else {
                        row.classList.add('bg-rose-50/40');
                        subLogs.push(`${sub.key}:-`);
                    }
                });

                let qScore = 0;
                if (correctCount === 1) qScore = 0.1;
                else if (correctCount === 2) qScore = 0.25;
                else if (correctCount === 3) qScore = 0.5;
                else if (correctCount === 4) qScore = 1.0;

                scoreP2 += qScore;
                detailP2.push(`C${q.id}[${subLogs.join(',')}]=${qScore}đ`);

                const navBtn = document.getElementById(`nav-p2-q${q.id}`);
                navBtn.className = correctCount === 4
                    ? "h-8 rounded-lg bg-emerald-500 text-white text-xs font-semibold flex items-center justify-center"
                    : "h-8 rounded-lg bg-amber-500 text-white text-xs font-semibold flex items-center justify-center";

                document.getElementById(`exp-p2-q${q.id}`).classList.remove('hidden');
            });

            // 3. Chấm Phần III (0.5đ / câu)
            let scoreP3 = 0;
            let detailP3 = [];

            part3Data.forEach(q => {
                const inputEl = document.getElementById(`p3_q${q.id}_input`);
                inputEl.disabled = true;
                const rawVal = inputEl.value.trim().replace(/\s+/g, '');
                const badge = document.getElementById(`p3-badge-q${q.id}`);
                const navBtn = document.getElementById(`nav-p3-q${q.id}`);

                const isCorrect = q.answers.includes(rawVal);
                badge.classList.remove('hidden');

                if (isCorrect) {
                    scoreP3 += 0.5;
                    inputEl.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');
                    badge.className = "text-xs font-bold px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800";
                    badge.innerHTML = `<i class="fa-solid fa-check"></i> Chính xác (+0,5đ)`;
                    navBtn.className = "h-8 rounded-lg bg-emerald-500 text-white text-xs font-semibold flex items-center justify-center";
                    detailP3.push(`C${q.id}:${rawVal}(Đ)`);
                } else {
                    inputEl.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-900');
                    badge.className = "text-xs font-bold px-2.5 py-1 rounded-lg bg-rose-100 text-rose-800";
                    badge.innerHTML = `<i class="fa-solid fa-xmark"></i> Sai (Đáp án: ${q.answers[0]})`;
                    navBtn.className = "h-8 rounded-lg bg-rose-500 text-white text-xs font-semibold flex items-center justify-center";
                    detailP3.push(`C${q.id}:${rawVal || 'Trống'}(S)`);
                }

                document.getElementById(`exp-p3-q${q.id}`).classList.remove('hidden');
            });

            // 4. Lưu Phần IV & Hiện đáp án
            let essayLogs = [];
            part4Data.forEach(q => {
                const txt = document.getElementById(`p4_q${q.id}_input`);
                txt.disabled = true;
                essayLogs.push(`Câu ${q.id}: ${txt.value.trim() || '(Không làm)'}`);
                document.getElementById(`exp-p4-q${q.id}`).classList.remove('hidden');
            });

            const totalScore = Math.round((scoreP1 + scoreP2 + scoreP3) * 100) / 100;

            // Hiển thị bảng kết quả
            const banner = document.getElementById('result-banner');
            banner.classList.remove('hidden');
            document.getElementById('score-total-display').textContent = `Điểm trắc nghiệm: ${totalScore.toFixed(2)} / 7.00`;
            document.getElementById('score-breakdown-display').textContent = `Phần I: ${scoreP1.toFixed(2)}/3.00đ • Phần II: ${scoreP2.toFixed(2)}/2.00đ • Phần III: ${scoreP3.toFixed(2)}/2.00đ (Phần IV Tự luận 3.0đ đối chiếu đáp án bên dưới)`;

            // Disable nút nộp bài
            document.getElementById('btn-submit-top').disabled = true;
            document.getElementById('btn-submit-top').classList.add('opacity-50', 'cursor-not-allowed');
            document.getElementById('btn-submit-bottom').disabled = true;
            document.getElementById('btn-submit-bottom').classList.add('opacity-50', 'cursor-not-allowed');

            // Cuộn lên đầu trang xem điểm
            window.scrollTo({ top: 0, behavior: 'smooth' });

            // Chuẩn bị dữ liệu gửi Google Sheet
            lastResultPayload = {
                name: name,
                studentClass: sClass,
                studentId: sId,
                duration: durationStr,
                totalScore: totalScore.toFixed(2),
                scoreP1: scoreP1.toFixed(2),
                scoreP2: scoreP2.toFixed(2),
                scoreP3: scoreP3.toFixed(2),
                detailP1: detailP1.join(' | '),
                detailP2: detailP2.join(' | '),
                detailP3: detailP3.join(' | '),
                essay: essayLogs.join(' || ')
            };

            sendToGoogleSheet(lastResultPayload);
        }

        function sendToGoogleSheet(payload) {
            const gasUrl = localStorage.getItem('toan12_gas_url');
            const statusEl = document.getElementById('sheet-status-msg');

            if (!gasUrl) {
                statusEl.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-amber-300"></i> <span>Chưa cấu hình URL Google Sheet (Nhấn <b>"Cấu hình Sheet"</b> ở góc trên để kết nối, hoặc tải file Excel bên cạnh).</span>`;
                return;
            }

            statusEl.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Đang gửi kết quả sang Google Sheet...</span>`;

            fetch(gasUrl, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(() => {
                statusEl.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-300"></i> <span>Đã xuất kết quả thành công sang Google Sheet!</span>`;
            })
            .catch(err => {
                console.error(err);
                statusEl.innerHTML = `<i class="fa-solid fa-circle-xmark text-rose-300"></i> <span>Lỗi khi gửi sang Google Sheet. Vui lòng tải file Excel dự phòng.</span>`;
            });
        }

        // Xuất dự phòng file CSV mở trực tiếp bằng Excel / Google Sheet
        function exportCSV() {
            if (!lastResultPayload) return;
            const p = lastResultPayload;
            const headers = ["Thời gian nộp", "Họ và tên", "Lớp", "SBD/Mã HS", "Thời gian làm", "Tổng điểm TN", "Điểm P1", "Điểm P2", "Điểm P3", "Chi tiết P1", "Chi tiết P2", "Chi tiết P3", "Bài Tự Luận"];
            const row = [
                new Date().toLocaleString("vi-VN"),
                p.name, p.studentClass, p.studentId, p.duration,
                p.totalScore, p.scoreP1, p.scoreP2, p.scoreP3,
                p.detailP1, p.detailP2, p.detailP3, p.essay
            ].map(val => `"${String(val).replace(/"/g, '""')}"`);

            const csvContent = "\uFEFF" + headers.join(",") + "\n" + row.join(",");
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `KetQua_Toan12_${p.name}_${p.studentClass}.csv`;
            a.click();
            URL.revokeObjectURL(url);
        }

        // Khởi chạy khi tải trang
        window.onload = function() {
            renderExam();
            startTimer();
        };
    </script>
