                <text x="74" y="159" font-size="12" fill="#0f172a">-1</text>
                <text x="152" y="138" font-size="12" fill="#0f172a">1</text>
                <text x="127" y="59" font-size="12" fill="#0f172a">3</text>
                <text x="100" y="179" font-size="12" fill="#0f172a">-1</text>
            </svg>
        </div>`;

        // SVG Đồ thị Câu 2
        const svgCau2 = `
        <div class="my-3 flex justify-center">
            <svg width="250" height="210" viewBox="0 0 250 210" class="bg-white border border-slate-100 rounded-xl p-2">
                <!-- Axes -->
                <line x1="15" y1="115" x2="235" y2="115" stroke="#334155" stroke-width="1.5" marker-end="url(#arrow2)"/>
                <line x1="125" y1="200" x2="125" y2="15" stroke="#334155" stroke-width="1.5" marker-end="url(#arrow2)"/>
                <defs>
                    <marker id="arrow2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                        <path d="M 0 1 L 10 5 L 0 9 z" fill="#334155"/>
                    </marker>
                </defs>
                <!-- Asymptotes: x = -1 (x=95), y = 1 (y=85) -->
                <line x1="95" y1="20" x2="95" y2="195" stroke="#64748b" stroke-width="1.3"/>
                <line x1="20" y1="85" x2="225" y2="85" stroke="#64748b" stroke-width="1.3"/>
                <!-- Hyperbola branches: y = (x - 2)/(x + 1) -->
                <path d="M 22 77 Q 75 72, 90 22" fill="none" stroke="#2563eb" stroke-width="2.2"/>
                <path d="M 101 195 Q 112 125, 185 115 Q 205 112, 222 108" fill="none" stroke="#2563eb" stroke-width="2.2"/>
                <!-- Labels -->
                <text x="225" y="108" font-size="13" font-style="italic" fill="#0f172a">x</text>
