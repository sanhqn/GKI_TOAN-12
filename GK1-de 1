<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đề Kiểm Tra Cuối Kỳ I - Môn Toán Lớp 12</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- MathJax for Math Formulas -->
    <script>
        window.MathJax = {
            tex: {
                inlineMath: [['$', '$'], ['\\(', '\\)']],
                displayMath: [['$$', '$$'], ['\\[', '\\]']]
            },
            svg: { fontCache: 'global' }
        };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .math-table th, .math-table td {
            border: 1px solid #cbd5e1;
            padding: 8px 12px;
            text-align: center;
        }
        .math-table th {
            background-color: #f1f5f9;
            font-weight: 600;
        }
        /* Custom radio/checkbox styling */
        .option-label {
            transition: all 0.2s ease;
        }
        .option-input:checked + .option-label {
            background-color: #eff6ff;
            border-color: #2563eb;
            color: #1e40af;
            font-weight: 500;
        }
        /* Smooth scroll */
        html {
            scroll-behavior: smooth;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Top Sticky Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-lg shadow-sm">
                    <i class="fa-solid fa-square-root-variable"></i>
                </div>
                <div>
                    <h1 class="font-bold text-slate-800 text-base sm:text-lg leading-tight">ĐỀ KIỂM TRA CUỐI KỲ I - TOÁN 12</h1>
                    <p class="text-xs text-slate-500">Kết nối tri thức với cuộc sống • Thời gian: 90 phút</p>
                </div>
            </div>

            <div class="flex items-center gap-2 sm:gap-4">
                <!-- Config Google Sheet Button -->
                <button onclick="openConfigModal()" class="px-3 py-2 text-xs sm:text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition flex items-center gap-1.5" title="Cấu hình xuất Google Sheet">
                    <i class="fa-solid fa-file-excel text-emerald-600"></i>
                    <span class="hidden sm:inline">Cấu hình Sheet</span>
                </button>

                <!-- Timer -->
                <div id="timer-box" class="px-3.5 py-1.5 bg-amber-50 border border-amber-200 text-amber-800 rounded-lg font-mono font-bold text-base sm:text-lg flex items-center gap-2">
                    <i class="fa-regular fa-clock text-amber-600"></i>
                    <span id="timer-display">90:00</span>
                </div>

                <!-- Submit Button -->
                <button id="btn-submit-top" onclick="confirmSubmit()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-lg shadow-sm transition flex items-center gap-2">
                    <i class="fa-solid fa-paper-plane"></i>
                    <span>Nộp bài</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-6xl w-full mx-auto px-4 py-6 flex-1 grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left Column: Student Info & Questions -->
        <div class="lg:col-span-9 space-y-6">
            
            <!-- Student Information Card -->
            <section class="bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-slate-200">
                <h2 class="text-base font-bold text-slate-800 mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-user-graduate text-blue-600"></i>
                    THÔNG TIN THÍ SINH
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Họ và tên <span class="text-red-500">*</span></label>
                        <input type="text" id="student-name" placeholder="Nguyễn Văn A" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none text-sm transition">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Lớp <span class="text-red-500">*</span></label>
                        <input type="text" id="student-class" placeholder="12A1" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none text-sm transition">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Số báo danh / Mã HS</label>
                        <input type="text" id="student-id" placeholder="VD: 12001" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none text-sm transition">
                    </div>
                </div>
            </section>

            <!-- Result Banner (Hidden initially) -->
            <div id="result-banner" class="hidden bg-gradient-to-r from-blue-600 to-indigo-700 text-white p-6 rounded-2xl shadow-md">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                    <div>
                        <span class="px-3 py-1 bg-white/20 rounded-full text-xs font-semibold uppercase tracking-wider">Kết quả bài làm</span>
                        <h3 class="text-2xl sm:text-3xl font-extrabold mt-2" id="score-total-display">Điểm trắc nghiệm: 0.00 / 7.00</h3>
                        <p class="text-blue-100 text-sm mt-1" id="score-breakdown-display">Phần I: 0/3.0đ • Phần II: 0/2.0đ • Phần III: 0/2.0đ (Phần IV Tự luận 3.0đ giáo viên chấm)</p>
                        <p class="text-xs text-emerald-200 mt-2 flex items-center gap-1.5" id="sheet-status-msg">
                            <i class="fa-solid fa-circle-info"></i> <span>Đang kiểm tra kết nối Google Sheet...</span>
                        </p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button onclick="exportCSV()" class="px-4 py-2.5 bg-white text-blue-700 hover:bg-blue-50 font-semibold text-sm rounded-xl shadow transition flex items-center gap-2">
                            <i class="fa-solid fa-download"></i> Tải file Excel (.csv)
                        </button>
                    </div>
                </div>
            </div>

            <!-- PART I: MULTIPLE CHOICE -->
            <section class="bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-slate-200 space-y-6">
                <div class="border-b border-slate-100 pb-3">
                    <h2 class="text-lg font-bold text-blue-700">PHẦN I. Câu trắc nghiệm nhiều phương án lựa chọn (3,0 điểm)</h2>
                    <p class="text-sm text-slate-500">Thí sinh trả lời từ câu 1 đến câu 12. Mỗi câu hỏi thí sinh chỉ chọn một phương án (0,25 điểm/câu).</p>
                </div>

                <div id="part1-container" class="space-y-8">
                    <!-- Questions 1 to 12 will be rendered by JS -->
                </div>
            </section>

            <!-- PART II: TRUE / FALSE -->
            <section class="bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-slate-200 space-y-6">
                <div class="border-b border-slate-100 pb-3">
                    <h2 class="text-lg font-bold text-blue-700">PHẦN II. Câu trắc nghiệm đúng sai (2,0 điểm)</h2>
                    <p class="text-sm text-slate-500">Thí sinh trả lời từ câu 1 đến câu 2. Trong mỗi ý a), b), c), d) ở mỗi câu, thí sinh chọn Đúng hoặc Sai.</p>
                </div>

                <div id="part2-container" class="space-y-8">
                    <!-- Part II Questions rendered by JS -->
                </div>
            </section>

            <!-- PART III: SHORT ANSWER -->
            <section class="bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-slate-200 space-y-6">
                <div class="border-b border-slate-100 pb-3">
                    <h2 class="text-lg font-bold text-blue-700">PHẦN III. Câu trắc nghiệm trả lời ngắn (2,0 điểm)</h2>
                    <p class="text-sm text-slate-500">Thí sinh trả lời từ câu 1 đến câu 4 (0,5 điểm/câu). Dùng dấu phẩy hoặc dấu chấm cho số thập phân.</p>
                </div>

                <div id="part3-container" class="space-y-8">
                    <!-- Part III Questions rendered by JS -->
                </div>
            </section>

            <!-- PART IV: ESSAY -->
            <section class="bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-slate-200 space-y-6">
                <div class="border-b border-slate-100 pb-3">
                    <h2 class="text-lg font-bold text-blue-700">PHẦN IV. Tự luận (3,0 điểm)</h2>
                    <p class="text-sm text-slate-500">Thí sinh nhập tóm tắt lời giải hoặc đáp số vào ô bên dưới để lưu trữ cùng bài làm.</p>
                </div>

                <div id="part4-container" class="space-y-8">
                    <!-- Part IV Questions rendered by JS -->
                </div>
            </section>

            <!-- Bottom Submit Button -->
            <div class="flex justify-center pt-2 pb-8">
                <button id="btn-submit-bottom" onclick="confirmSubmit()" class="w-full sm:w-auto px-8 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-base rounded-xl shadow-md transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-check-double"></i>
                    <span>HOÀN THÀNH & NỘP BÀI</span>
                </button>
            </div>
        </div>

        <!-- Right Column: Question Palette -->
        <aside class="lg:col-span-3">
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 sticky top-20 space-y-4">
                <h3 class="font-bold text-slate-800 text-sm flex items-center justify-between">
                    <span>BẢNG CÂU HỎI</span>
                    <span id="progress-text" class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-md">0/18 câu</span>
                </h3>

                <div>
                    <p class="text-xs font-semibold text-slate-500 mb-2">Phần I (Trắc nghiệm)</p>
                    <div id="nav-part1" class="grid grid-cols-6 gap-1.5"></div>
                </div>

                <div>
                    <p class="text-xs font-semibold text-slate-500 mb-2">Phần II (Đúng/Sai)</p>
                    <div id="nav-part2" class="grid grid-cols-4 gap-1.5"></div>
                </div>

                <div>
                    <p class="text-xs font-semibold text-slate-500 mb-2">Phần III (Trả lời ngắn)</p>
                    <div id="nav-part3" class="grid grid-cols-4 gap-1.5"></div>
                </div>

                <div>
                    <p class="text-xs font-semibold text-slate-500 mb-2">Phần IV (Tự luận)</p>
                    <div id="nav-part4" class="grid grid-cols-4 gap-1.5"></div>
                </div>

                <div class="pt-3 border-t border-slate-100 text-xs text-slate-500 space-y-1.5">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded bg-slate-100 border border-slate-300 inline-block"></span> Chưa làm
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded bg-blue-600 inline-block"></span> Đã trả lời
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded bg-emerald-500 inline-block"></span> Đúng (sau nộp bài)
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded bg-rose-500 inline-block"></span> Sai (sau nộp bài)
                    </div>
                </div>
            </div>
        </aside>
    </main>

    <!-- Custom Modal for Alerts & Confirmations -->
    <div id="custom-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
            <div class="flex items-center gap-3">
                <div id="modal-icon" class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-circle-question"></i>
                </div>
                <h3 id="modal-title" class="font-bold text-lg text-slate-800">Xác nhận nộp bài</h3>
            </div>
            <p id="modal-message" class="text-sm text-slate-600 leading-relaxed"></p>
            <div id="modal-actions" class="flex justify-end gap-2 pt-2">
                <button onclick="closeModal()" class="px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition">Hủy</button>
                <button id="modal-confirm-btn" class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition">Đồng ý</button>
            </div>
        </div>
    </div>

    <!-- Google Sheet Configuration Modal -->
    <div id="config-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-xl space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="font-bold text-lg text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-table text-emerald-600"></i>
                    Kết nối xuất kết quả sang Google Sheet
                </h3>
                <button onclick="closeConfigModal()" class="text-slate-400 hover:text-slate-600 text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="space-y-3 text-sm text-slate-600">
                <label class="block font-semibold text-slate-800">1. Dán URL Web App của Google Apps Script vào đây:</label>
                <input type="url" id="gas-url-input" placeholder="https://script.google.com/macros/s/AKfycb.../exec" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none text-sm font-mono">
                
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2">
                    <p class="font-semibold text-slate-800 text-xs uppercase">2. Hướng dẫn thiết lập nhanh (Chỉ làm 1 lần):</p>
                    <ol class="list-decimal list-inside space-y-1 text-xs text-slate-600">
                        <li>Tạo một file <strong>Google Sheet</strong> mới trên Google Drive.</li>
                        <li>Trên thanh menu chọn <strong>Tiện ích mở rộng (Extensions)</strong> &rarr; <strong>Apps Script</strong>.</li>
                        <li>Xóa mã cũ, dán đoạn mã bên dưới vào và nhấn <strong>Lưu (Ctrl+S)</strong>.</li>
                        <li>Nhấn nút <strong>Triển khai (Deploy)</strong> &rarr; <strong>Tùy chọn triển khai mới (New deployment)</strong> &rarr; Chọn loại: <strong>Ứng dụng web (Web app)</strong>.</li>
                        <li>Ở mục <em>Ai có quyền truy cập (Who has access)</em> chọn <strong>Bất kỳ ai (Anyone)</strong> &rarr; Nhấn <strong>Triển khai</strong> và sao chép URL dán vào ô phía trên.</li>
                    </ol>
                    <div class="relative mt-2">
                        <pre id="gas-code-block" class="bg-slate-800 text-emerald-300 p-3 rounded-lg text-xs overflow-x-auto font-mono leading-relaxed">function doPost(e) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var data = JSON.parse(e.postData.contents);
  
  if (sheet.getLastRow() === 0) {
    sheet.appendRow(["Thời gian nộp", "Họ và tên", "Lớp", "SBD/Mã HS", "Thời gian làm", "Tổng điểm TN", "Điểm P1", "Điểm P2", "Điểm P3", "Chi tiết P1", "Chi tiết P2", "Chi tiết P3", "Bài Tự Luận"]);
  }
  
  sheet.appendRow([
    new Date().toLocaleString("vi-VN"),
    data.name,
    data.studentClass,
    data.studentId,
    data.duration,
    data.totalScore,
    data.scoreP1,
    data.scoreP2,
    data.scoreP3,
    data.detailP1,
    data.detailP2,
    data.detailP3,
    data.essay
  ]);
  
  return ContentService.createTextOutput(JSON.stringify({"status": "success"})).setMimeType(ContentService.MimeType.JSON);
}</pre>
                        <button onclick="copyGasCode()" class="absolute top-2 right-2 px-2.5 py-1 bg-white/10 hover:bg-white/20 text-white text-xs rounded-md transition flex items-center gap-1">
                            <i class="fa-regular fa-copy"></i> <span id="copy-btn-text">Sao chép mã</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
                <button onclick="closeConfigModal()" class="px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition">Đóng</button>
                <button onclick="saveGasUrl()" class="px-4 py-2 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl transition">Lưu cấu hình</button>
            </div>
        </div>
    </div>

    <script>
