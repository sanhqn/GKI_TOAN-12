<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thầy SAH - Mô Phỏng Khối Chóp 3D S.ABCD</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Three.js & OrbitControls -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  
  <!-- KaTeX -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js" onload="renderKaTeX()"></script>

  <style>
    body {
      background-color: #0f0c1b;
      color: #38bdf8;
      font-family: system-ui, -apple-system, sans-serif;
      overflow-x: hidden;
    }
    .custom-card {
      background: rgba(26, 21, 47, 0.85);
      border: 1px solid rgba(56, 189, 248, 0.3);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(10px);
    }
    .vertex-label {
      position: absolute;
      color: #38bdf8;
      font-weight: bold;
      font-size: 14px;
      font-family: monospace;
      pointer-events: none;
      text-shadow: 0 0 6px rgba(56, 189, 248, 0.8), 0 0 2px #000;
      transform: translate(-50%, -50%);
    }
    /* Style cho thanh trượt Slider */
    input[type=range] {
      accent-color: #38bdf8;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

  <!-- HEADER -->
  <header class="w-full py-4 px-6 custom-card flex flex-wrap items-center justify-between z-10">
    <div class="flex items-center gap-3">
      <div class="p-1 bg-[#1a152f] rounded-full border border-cyan-500/40">
        <img src="https://i.imgur.com/7b7X8e3.png" alt="Logo" class="w-10 h-10 rounded-full object-cover" onerror="this.src='https://placehold.co/100x100/1a152f/38bdf8?text=SAH'">
      </div>
      <div>
        <h1 class="text-base font-bold text-cyan-400 tracking-wider uppercase">THẦY SAH - TOÁN HỌC</h1>
        <p class="text-xs text-cyan-300/70">Trực quan hóa Khối Hình Học Không Gian 3D</p>
      </div>
    </div>
    <div class="mt-2 sm:mt-0 text-xs bg-cyan-950/80 text-cyan-300 px-3 py-1.5 rounded-lg border border-cyan-500/30">
      Chủ đề: <span class="font-bold text-cyan-200">Khối chóp đều $S.ABCD$</span>
    </div>
  </header>

  <!-- PHẦN CHÍNH: KHUNG HÌNH 3D VÀ BẢNG ĐIỀU KHIỂN -->
  <main class="flex-1 w-full max-w-7xl mx-auto p-4 grid grid-cols-1 lg:grid-cols-3 gap-6 items-start relative">
    
    <!-- KHUNG HÌNH 3D (Chiếm 2 cột) -->
    <div class="lg:col-span-2 custom-card rounded-2xl p-2 relative h-[500px] lg:h-[620px] overflow-hidden flex flex-col">
      <!-- Container chứa canvas 3D -->
      <div id="canvas-container" class="w-full h-full relative cursor-grab active:cursor-grabbing">
        <!-- Các nhãn đỉnh 3D HTML sẽ được chèn động vào đây -->
        <div id="labels-container" class="absolute inset-0 pointer-events-none"></div>
      </div>
      
      <!-- Hướng dẫn sử dụng nhanh -->
      <div class="absolute bottom-4 left-4 text-xs text-cyan-300/60 bg-[#0f0c1b]/80 p-2 rounded-lg border border-cyan-500/20 backdrop-filter blur">
        💡 Kéo chuột để xoay | Cuộn để phóng to/thu nhỏ
      </div>
    </div>

    <!-- BẢNG ĐIỀU KHIỂN VÀ TÍNH TOÁN (Chiếm 1 cột) -->
    <div class="space-y-4">
      
      <!-- Panel Điều khiển Tham số -->
      <div class="custom-card p-5 rounded-2xl space-y-4">
        <h2 class="text-sm font-bold text-cyan-300 uppercase tracking-wider border-b border-cyan-500/20 pb-2">
          ⚙️ Điều chỉnh tham số
        </h2>

        <!-- Slider Chiều cao -->
        <div>
          <div class="flex justify-between text-xs text-cyan-200 mb-1">
            <span>Chiều cao khối chóp ($h = SO$):</span>
            <span id="val-height" class="font-bold text-cyan-400">4.0</span>
          </div>
          <input type="range" id="slider-height" min="1" max="8" step="0.1" value="4" class="w-full h-2 bg-[#0f0c1b] rounded-lg cursor-pointer">
        </div>

        <!-- Slider Kích thước Cạnh đáy -->
        <div>
          <div class="flex justify-between text-xs text-cyan-200 mb-1">
            <span>Độ dài cạnh đáy ($a = AB$):</span>
            <span id="val-base" class="font-bold text-cyan-400">4.0</span>
          </div>
          <input type="range" id="slider-base" min="1" max="6" step="0.1" value="4" class="w-full h-2 bg-[#0f0c1b] rounded-lg cursor-pointer">
        </div>

        <!-- Nút Tự động xoay -->
        <div class="pt-2 flex justify-between items-center">
          <span class="text-xs text-cyan-200">Tự động xoay mô hình:</span>
          <button id="btn-rotate" onclick="toggleAutoRotate()" class="px-3 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold rounded-lg transition">
            Bật Xoay
          </button>
        </div>
      </div>

      <!-- Panel Tính toán Thể tích KaTeX -->
      <div class="custom-card p-5 rounded-2xl space-y-3">
        <h2 class="text-sm font-bold text-cyan-300 uppercase tracking-wider border-b border-cyan-500/20 pb-2">
          📐 Tính toán Thể tích
        </h2>
        
        <div class="text-xs text-cyan-200 space-y-2">
          <p>Công thức thể tích khối chóp:</p>
          <div class="p-2.5 bg-[#0f0c1b] rounded-xl border border-cyan-500/20 text-center text-sm text-cyan-300">
            $$V = \frac{1}{3} \cdot S_{\text{đáy}} \cdot h$$
          </div>

          <div class="space-y-1 pt-2">
            <p>• Diện tích đáy hình vuông $ABCD$:</p>
            <p class="text-cyan-400 font-mono text-center" id="calc-base-area">$$S_{\text{đáy}} = a^2 = 16.00$$</p>
          </div>

          <div class="space-y-1 pt-2 border-t border-cyan-500/20">
            <p>• Thể tích khối chóp $S.ABCD$:</p>
            <p class="text-emerald-400 font-bold font-mono text-center text-sm" id="calc-volume">$$V = \frac{1}{3} \cdot 16.00 \cdot 4.00 = 21.33$$</p>
          </div>
        </div>
      </div>

    </div>

  </main>

  <!-- FOOTER -->
  <footer class="w-full py-3 text-center text-xs text-cyan-400/50 border-t border-cyan-500/20">
    © 2026 Thầy SAH - Toán Học. Thiết kế mô phỏng 3D tương tác.
  </footer>

  <!-- JAVASCRIPT XỬ LÝ THREE.JS & KATEX -->
  <script>
    // --- BẢNG BIẾN TOÀN CỤC ---
    let scene, camera, renderer, controls;
    let pyramidMesh, wireframeMesh, heightLineMesh;
    let autoRotate = false;

    // Kích thước mặc định
    let baseSize = 4.0;
    let heightVal = 4.0;

    const container = document.getElementById('canvas-container');
    const labelsContainer = document.getElementById('labels-container');

    // Các điểm tọa độ đỉnh trong không gian 3D
    let vertices3D = { S: null, A: null, B: null, C: null, D: null, O: null };
    let labelElements = {};

    // --- KHI TRANG TẢI XONG ---
    window.onload = function() {
      initThreeJS();
      createPyramid();
      createLabelsHTML();
      animate();
      updateCalculations();
      
      // Lắng nghe sự kiện Resize cửa sổ
      window.addEventListener('resize', onWindowResize);

      // Gán sự kiện cho các slider
      document.getElementById('slider-height').addEventListener('input', (e) => {
        heightVal = parseFloat(e.target.value);
        document.getElementById('val-height').innerText = heightVal.toFixed(1);
        updatePyramidGeometry();
        updateCalculations();
      });

      document.getElementById('slider-base').addEventListener('input', (e) => {
        baseSize = parseFloat(e.target.value);
        document.getElementById('val-base').innerText = baseSize.toFixed(1);
        updatePyramidGeometry();
        updateCalculations();
      });
    };

    // --- NGHỆ THUẬT KHỞI TẠO THREE.JS ---
    function initThreeJS() {
      const width = container.clientWidth;
      const height = container.clientHeight;

      // 1. Scene
      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x0f0c1b);

      // 2. Camera
      camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
      camera.position.set(7, 6, 9);

      // 3. Renderer
      renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(window.devicePixelRatio);
      container.appendChild(renderer.domElement);

      // 4. Controls (OrbitControls xoay mô hình)
      controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.05;

      // 5. Ánh sáng (Lighting)
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
      scene.add(ambientLight);

      const dirLight1 = new THREE.DirectionalLight(0x38bdf8, 0.8);
      dirLight1.position.set(10, 20, 15);
      scene.add(dirLight1);

      const dirLight2 = new THREE.DirectionalLight(0xa855f7, 0.5);
      dirLight2.position.set(-10, -10, -10);
      scene.add(dirLight2);

      // Grid mặt phẳng tọa độ mờ phía dưới
      const gridHelper = new THREE.GridHelper(14, 14, 0x38bdf8, 0x1a152f);
      gridHelper.position.y = 0;
      scene.add(gridHelper);
    }

    // --- TẠO MÔ HÌNH KHỐI CHÓP S.ABCD ---
    function createPyramid() {
      // 1. Tạo Mesh các mặt bán trong suốt (Semi-transparent mesh)
      const geometry = new THREE.BufferGeometry();
      const material = new THREE.MeshPhongMaterial({
        color: 0x0284c7,
        transparent: true,
        opacity: 0.45,
        side: THREE.DoubleSide,
        shininess: 80
      });

      pyramidMesh = new THREE.Mesh(geometry, material);
      scene.add(pyramidMesh);

      // 2. Tạo khung dây viền (Wireframe)
      const wireframeMaterial = new THREE.LineBasicMaterial({ color: 0x38bdf8, linewidth: 2 });
      wireframeMesh = new THREE.LineSegments(new THREE.BufferGeometry(), wireframeMaterial);
      scene.add(wireframeMesh);

      // 3. Tạo đường cao SO (Màu đỏ/cam nét đứt hoặc viền nổi bật)
      const heightMaterial = new THREE.LineDashedMaterial({
        color: 0xf97316,
        dashSize: 0.2,
        gapSize: 0.1,
        linewidth: 2
      });
      heightLineMesh = new THREE.Line(new THREE.BufferGeometry(), heightMaterial);
      scene.add(heightLineMesh);

      // Cập nhật vị trí đỉnh & hình dạng ban đầu
      updatePyramidGeometry();
    }

    // --- CẬP NHẬT TỌA ĐỘ VÀ HÌNH HỌC KHỐI CHÓP ---
    function updatePyramidGeometry() {
      const half = baseSize / 2;

      // Đặt gốc O(0,0,0) làm tâm đáy hình vuông ABCD
      vertices3D.O = new THREE.Vector3(0, 0, 0);
      vertices3D.S = new THREE.Vector3(0, heightVal, 0);
      vertices3D.A = new THREE.Vector3(-half, 0, half);
      vertices3D.B = new THREE.Vector3(half, 0, half);
      vertices3D.C = new THREE.Vector3(half, 0, -half);
      vertices3D.D = new THREE.Vector3(-half, 0, -half);

      // --- Cập nhật Mesh Mặt khối chóp ---
      // 4 Mặt bên + 2 Tam giác ghép thành Đáy hình vuông
      const positions = new Float32Array([
        // Mặt S-A-B
        vertices3D.S.x, vertices3D.S.y, vertices3D.S.z,  vertices3D.A.x, vertices3D.A.y, vertices3D.A.z,  vertices3D.B.x, vertices3D.B.y, vertices3D.B.z,
        // Mặt S-B-C
        vertices3D.S.x, vertices3D.S.y, vertices3D.S.z,  vertices3D.B.x, vertices3D.B.y, vertices3D.B.z,  vertices3D.C.x, vertices3D.C.y, vertices3D.C.z,
        // Mặt S-C-D
        vertices3D.S.x, vertices3D.S.y, vertices3D.S.z,  vertices3D.C.x, vertices3D.C.y, vertices3D.C.z,  vertices3D.D.x, vertices3D.D.y, vertices3D.D.z,
        // Mặt S-D-A
        vertices3D.S.x, vertices3D.S.y, vertices3D.S.z,  vertices3D.D.x, vertices3D.D.y, vertices3D.D.z,  vertices3D.A.x, vertices3D.A.y, vertices3D.A.z,
        // Đáy A-B-C
        vertices3D.A.x, vertices3D.A.y, vertices3D.A.z,  vertices3D.B.x, vertices3D.B.y, vertices3D.B.z,  vertices3D.C.x, vertices3D.C.y, vertices3D.C.z,
        // Đáy A-C-D
        vertices3D.A.x, vertices3D.A.y, vertices3D.A.z,  vertices3D.C.x, vertices3D.C.y, vertices3D.C.z,  vertices3D.D.x, vertices3D.D.y, vertices3D.D.z
      ]);

      pyramidMesh.geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      pyramidMesh.geometry.computeVertexNormals();

      // --- Cập nhật Khung dây (Wireframe Line Segments) ---
      const wireframePositions = new Float32Array([
        // Đáy
        vertices3D.A.x, vertices3D.A.y, vertices3D.A.z,  vertices3D.B.x, vertices3D.B.y, vertices3D.B.z,
        vertices3D.B.x, vertices3D.B.y, vertices3D.B.z,  vertices3D.C.x, vertices3D.C.y, vertices3D.C.z,
        vertices3D.C.x, vertices3D.C.y, vertices3D.C.z,  vertices3D.D.x, vertices3D.D.y, vertices3D.D.z,
        vertices3D.D.x, vertices3D.D.y, vertices3D.D.z,  vertices3D.A.x, vertices3D.A.y, vertices3D.A.z,
        // Các cạnh bên
        vertices3D.S.x, vertices3D.S.y, vertices3D.S.z,  vertices3D.A.x, vertices3D.A.y, vertices3D.A.z,
        vertices3D.S.x, vertices3D.S.y, vertices3D.S.z,  vertices3D.B.x, vertices3D.B.y, vertices3D.B.z,
        vertices3D.S.x, vertices3D.S.y, vertices3D.S.z,  vertices3D.C.x, vertices3D.C.y, vertices3D.C.z,
        vertices3D.S.x, vertices3D.S.y, vertices3D.S.z,  vertices3D.D.x, vertices3D.D.y, vertices3D.D.z
      ]);

      wireframeMesh.geometry.setAttribute('position', new THREE.BufferAttribute(wireframePositions, 3));

      // --- Cập nhật Đường cao SO ---
      const heightPositions = new Float32Array([
        vertices3D.S.x, vertices3D.S.y, vertices3D.S.z,
        vertices3D.O.x, vertices3D.O.y, vertices3D.O.z
      ]);
      heightLineMesh.geometry.setAttribute('position', new THREE.BufferAttribute(heightPositions, 3));
      heightLineMesh.computeLineDistances();
    }

    // --- TẠO NHÃN CHỮ HTML CHO CÁC ĐỈNH (S, A, B, C, D, O) ---
    function createLabelsHTML() {
      labelsContainer.innerHTML = '';
      const names = ['S', 'A', 'B', 'C', 'D', 'O'];

      names.forEach(name => {
        const div = document.createElement('div');
        div.className = 'vertex-label';
        div.innerText = name;
        if (name === 'S') div.style.color = '#f43f5e'; // Đỉnh S nổi bật màu hồng đỏ
        if (name === 'O') div.style.color = '#f97316'; // Tâm O màu cam

        labelsContainer.appendChild(div);
        labelElements[name] = div;
      });
    }

    // --- CẬP NHẬT VỊ TRÍ NHÃN THEO KHÔNG GIAN 2D MÀN HÌNH ---
    function updateLabelsPosition() {
      const widthHalf = container.clientWidth / 2;
      const heightHalf = container.clientHeight / 2;

      for (const [name, vec] of Object.entries(vertices3D)) {
        if (!vec || !labelElements[name]) continue;

        // Nhân bản tọa độ và chiếu sang tọa độ màn hình
        const tempV = vec.clone();
        tempV.project(camera);

        const x = (tempV.x * widthHalf) + widthHalf;
        const y = -(tempV.y * heightHalf) + heightHalf;

        labelElements[name].style.left = `${x}px`;
        labelElements[name].style.top = `${y}px`;
      }
    }

    // --- TÍNH TOÁN VÀ HIỂN THỊ KATEX ---
    function updateCalculations() {
      const baseArea = baseSize * baseSize;
      const volume = (1 / 3) * baseArea * heightVal;

      const baseElem = document.getElementById('calc-base-area');
      const volElem = document.getElementById('calc-volume');

      if (window.katex) {
        katex.render(`S_{\\text{đáy}} = a^2 = ${baseSize.toFixed(1)}^2 = ${baseArea.toFixed(2)}`, baseElem);
        katex.render(`V = \\frac{1}{3} \\cdot ${baseArea.toFixed(2)} \\cdot ${heightVal.toFixed(1)} = ${volume.toFixed(2)}`, volElem);
      }
    }

    function renderKaTeX() {
      if (typeof renderMathInElement !== 'undefined') {
        renderMathInElement(document.body, {
          delimiters: [
            {left: '$$', right: '$$', display: true},
            {left: '$', right: '$', display: false}
          ],
          throwOnError: false
        });
      }
      updateCalculations();
    }

    // --- NÚT BẬT/TẮT TỰ ĐỘNG XOAY ---
    function toggleAutoRotate() {
      autoRotate = !autoRotate;
      controls.autoRotate = autoRotate;
      controls.autoRotateSpeed = 2.0;

      const btn = document.getElementById('btn-rotate');
      btn.innerText = autoRotate ? 'Tắt Xoay' : 'Bật Xoay';
      btn.className = autoRotate 
        ? 'px-3 py-1.5 bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold rounded-lg transition'
        : 'px-3 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold rounded-lg transition';
    }

    // --- THAY ĐỔI KÍCH THƯỚC CỬA SỔ ---
    function onWindowResize() {
      const width = container.clientWidth;
      const height = container.clientHeight;

      camera.aspect = width / height;
      camera.updateProjectionMatrix();

      renderer.setSize(width, height);
    }

    // --- VÒNG LẶP ANIMATION HOẠT HỌA ---
    function animate() {
      requestAnimationFrame(animate);

      controls.update();
      updateLabelsPosition();

      renderer.render(scene, camera);
    }
  </script>
</body>
</html>
